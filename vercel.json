{
 "$schema":"https://openapi.vercel.sh/vercel.json",
 "framework":"nextjs",
 "buildCommand":"npm run build",
 "installCommand":"npm ci",
 "regions":["bom1"],
 "functions":{"src/app/api/**/route.ts":{"maxDuration":30}},
 "headers":[{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"X-Frame-Options","value":"DENY"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]}]
}
